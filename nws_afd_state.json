      </li>\n                                                            <li>\n                                    <a href=\"https://www.weather.gov/ncep/\">National Centers</a>\n                                </li>\n                                                            <li>\n                                    <a href=\"https://www.noaa.gov/nws-careers\">Careers</a>\n                                </li>\n                                                            <li>\n                                    <a href=\"https://www.weather.gov/contact\">Contact Us</a>\n                                </li>\n                                                            <li>\n                                    <a href=\"https://forecast.weather.gov/glossary.php\">Glossary</a>\n                                </li>\n                                                            <li>\n                                    <a href=\"https://www.weather.gov/socialmedia\">Social Media</a>\n                                </li>\n                                                            <li>\n                                    <a href=\"https://www.noaa.gov/NWStransformation\">NWS Transformation</a>\n                                </li>\n                                                    </ul>\n                    </li>\n                            </ul>\n        </div>\n    </div>\n</nav>\n\n            <div class=\"contentArea\">\n                    \n        <span style=\"font-size: 20px; font-weight:bold;\">Area Forecast Discussion </span><br />Issued by NWS Houston/Galveston, TX\n        <br />\n        <br />\n        <div>\n                    <a href=\"/\">Home</a>&nbsp;|&nbsp;\n                    <b>Current Version</b>&nbsp;|&nbsp;\n                    <a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=2&glossary=0\">Previous Version</a>&nbsp;|&nbsp;\n                    <a href=\"?site=HGX&issuedby=HGX&product=AFD&format=txt&version=1&glossary=0\">Text Only</a>&nbsp;|&nbsp;\n                    <a href=\"javascript:window.print()\">Print</a>&nbsp;|&nbsp;<a href=\"product_types.php?site=HGX\">Product List</a>&nbsp;|&nbsp;\n                    <a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=1&glossary=1\">Glossary On</a></div>\n                <div>Versions:\n                            <b>1</b> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=2&glossary=0\">2</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=3&glossary=0\">3</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=4&glossary=0\">4</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=5&glossary=0\">5</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=6&glossary=0\">6</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=7&glossary=0\">7</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=8&glossary=0\">8</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=9&glossary=0\">9</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=10&glossary=0\">10</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=11&glossary=0\">11</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=12&glossary=0\">12</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=13&glossary=0\">13</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=14&glossary=0\">14</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=15&glossary=0\">15</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=16&glossary=0\">16</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=17&glossary=0\">17</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=18&glossary=0\">18</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=19&glossary=0\">19</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=20&glossary=0\">20</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=21&glossary=0\">21</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=22&glossary=0\">22</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=23&glossary=0\">23</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=24&glossary=0\">24</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=25&glossary=0\">25</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=26&glossary=0\">26</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=27&glossary=0\">27</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=28&glossary=0\">28</a> \n                            \n<a href=\"?site=HGX&issuedby=HGX&product=AFD&format=CI&version=29&glossary=0\">29</a> \n                    <hr size=\"1\" width=\"520\" noshade=\"noshade\" align=\"left\" />\n        </div>\n        <pre class=\"glossaryProduct\">\n874\nFXUS64 KHGX 031757\nAFDHGX\n\nArea Forecast Discussion\nNational Weather Service Houston/Galveston TX\n1257 PM CDT Mon Aug 3 2026\n\n...New DISCUSSION, MARINE...\n\n.KEY MESSAGES...\n\n- Seasonably hot with highs in the 90s and heat index values\n  101-108F each day.\n\n- An isolated late day shower can`t be ruled out along the\n  seabreeze, but most locations will remain dry.\n\n- Slightly better rain chances expected Thursday into the weekend\n  with some deeper moisture moving in from the Gulf.\n\n&&\n\n.DISCUSSION...\nIssued at 1257 AM CDT Mon Aug 3 2026\n\nPattern remains status quo for a good part of the week with\nmid/upper ridging situated across the Desert Southwest into Texas,\ntroffiness in the SE states, and ridging in the Atlantic. Locally,\ndrier air & subsidence should be fairly dominate and keep things\nmostly dry through the midweek period (though an isolated late day\nshower can`t totally be ruled out with the seabreeze).\n\nThursday and into the weekend, PW`s trend upward and closer to the\n2\" range. And, depending on your model of choice, maybe a few\nweak inverted H5 waves tracking wwd across the nrn Gulf Coast toward\nTX. Either should allow for slightly better diurnally driven rain\nchances and coverage (perhaps 30-40%). 47\n\n&&\n\n.AVIATION...\n(12Z TAF Issuance)\nIssued at 507 AM CDT Mon Aug 3 2026\n\nLight and variable winds will persist through most of the morning\nbefore becoming southerly to southeasterly in the afternoon hours.\nTerminals closer to the coast will start out with light south-\nsouthwesterly winds before transitioning to southeasterly winds\naround 10 kt this afternoon. Cannot rule out intermittent periods\nof patchy fog over the next few hours this morning in LBX/SGR.\nIsolated SH/TS possible this afternoon around the Houston metro\nterminals between 20Z-01Z, but the potential is too low to include\nit in any of the TAFs. Brief periods of patchy fog will be\npossible again early Tuesday morning.\n\nBatiste\n\n&&\n\n.MARINE...\nIssued at 1257 AM CDT Mon Aug 3 2026\n\nLight to moderate onshore winds and low seas are expected through\nthe forecast period. Rain chances will be low through most of the\nwork week and slightly increase going into the weekend.  47\n\n&&\n\n.PRELIMINARY POINT TEMPS/POPS...\nCollege Station (CLL)  76  99  76  98 /   0   0   0  10\nHouston (IAH)  78  99  78  97 /  20  10   0  20\nGalveston (GLS)  83  92  83  91 /  10   0   0  10\n\n&&\n\n.HGX WATCHES/WARNINGS/ADVISORIES...\nTX...None.\nGM...None.\n\n&&\n\n$$\n\nDISCUSSION...47\nAVIATION...Batiste\nMARINE...47\n\n\n</pre>\n\n                </div>\n            <footer>\n                                <div class=\"footer-legal\">\n    <div id=\"footerLogo\" class=\"col-xs-12 col-sm-2 col-md-2\">\n        <a href=\"//www.usa.gov\"><img src=\"/css/images/usa_gov.png\" alt=\"usa.gov\" width=\"110\" height=\"30\" /></a>\n    </div>\n    <div class=\"col-xs-12 col-sm-4 col-md-4\">\n        <ul class=\"list-unstyled footer-legal-content\">\n            <li><a href=\"//www.commerce.gov\">US Dept of Commerce</a></li>\n            <li><a href=\"//www.noaa.gov\">National Oceanic and Atmospheric Administration</a></li>\n            <li><a href=\"https://www.weather.gov\">National Weather Service</a></li>\n                        <li>1325 East West Highway<br /></li>\n                        <li>Silver Spring, MD 20910</li>\n            <li><br /><a href=\"https://www.weather.gov/Contact\">Comments? Questions? Please Contact Us.</a></li>\n        </ul>\n    </div>\n    <div class=\"col-xs-12 col-sm-3 col-md-3\">\n        <ul class=\"list-unstyled\">\n            <li><a href=\"https://www.weather.gov/disclaimer\">Disclaimer</a></li>\n            <li><a href=\"//www.cio.noaa.gov/services_programs/info_quality.html\">Information Quality</a></li>\n            <li><a href=\"https://www.weather.gov/help\">Help</a></li>\n            <li><a href=\"//www.weather.gov/glossary\">Glossary</a></li>\n        </ul>\n    </div>\n    <div class=\"col-xs-12 col-sm-3 col-md-3\">\n        <ul class=\"list-unstyled\">\n            <li><a href=\"https://www.weather.gov/privacy\">Privacy Policy</a></li>\n            <li><a href=\"https://www.noaa.gov/foia-freedom-of-information-act\">Freedom of Information Act (FOIA)</a></li>\n            <li><a href=\"https://www.weather.gov/about\">About Us</a></li>\n            <li><a href=\"https://www.weather.gov/careers\">Career Opportunities</a></li>\n        </ul>\n    </div>\n</div>\n\n            </footer>\n        </main>\n    </body>\n</html>\n",
